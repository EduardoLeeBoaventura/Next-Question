    <h2>Criar Questão</h2>
    <form id="question">
        <label for="question">Pergunta: </label>
        <input id="question" name="question" type="text">
        <label for="options">Opções: </label>
        <input id="options" name="options" type="text" placeholder="Separe as opções por dois espaços">
        <label for="correct">Alternativa correta: </label>
        <input id="correct" name="correct" type="text" pattern="[A-Z]" placeholder="A, B, C, D">
        <input type="submit" value="Criar Questão">
    </form>
    <script>
        // formulário de criar questionário
        const form = document.querySelector('#questionnaires')
        form.addEventListener('submit', event => {
            event.preventDefault()
    
            const data = new FormData(form)
    
            fetch('../controllers/criar_questionnaire.php', {
                method: 'POST',
                body: data
            })
            .then(response => response.json())
            .then(data => {
                if(data.status === 'success') {
                    alert('Questionário criado com sucesso!')
                    console.log(data)
                } else {
                    alert('Erro ao criar questionário, tente novamente mais tarde.')
                }
            })
            .catch(error => console.log(error))

        })

        // formulário de criar questão 

        const formQuestion = document.querySelector('#question')
        formQuestion.addEventListener('submit', event => {
            event.preventDefault()

            const data = new FormData(formQuestion)

            fetch('../controllers/criar_questions.php', {
                method: 'POST',
                body: data
            })
            .then(response => response.json())
            .then(data => {
                if(data.status === 'success') {
                    alert('Questão criada com sucesso!')
                    console.log(data)
                } else {
                    alert('Erro ao criar quest')
                }
            })
            .catch(error => console.log(error))
        })
    </script>
